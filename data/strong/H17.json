); error","n":4,"w":["toi","tou"]},"H8584":{"l":"תְּעוּדָה","t":"tᵉʻûwdâh","p":"teh-oo-daw'","d":"attestation, i.e. a precept, usage","k":"testimony.","o":"from H5749 (עוּד);","n":3,"w":["testimony"]},"H8585":{"l":"תְּעָלָה","t":"tᵉʻâlâh","p":"teh-aw-law'","d":"a channel (into which water is raised for irrigation); also a bandage or plaster (as placed upon a wound)","k":"conduit, cured, healing, little river, trench, watercourse.","o":"from H5927 (עָלָה);","n":11,"w":["conduit","trench","watercourse","healing","cured","rivers"]},"H8586":{"l":"תַּעֲלוּל","t":"taʻălûwl","p":"tah-al-ool'","d":"caprice (as a fit coming on), i.e. vexation; concretely a tyrant","k":"babe, delusion.","o":"from H5953 (עָלַל);","n":2,"w":["babes","delusions"]},"H8587":{"l":"תַּעֲלֻמָּה","t":"taʻălummâh","p":"tah-al-oom-maw'","d":"a secret","k":"thing that is hid, secret.","o":"from H5956 (עָלַם);","n":3,"w":["secrets","hid"]},"H8588":{"l":"תַּעֲנוּג","t":"taʻănûwg","p":"tah-an-oog'","d":"luxury","k":"delicate, delight, pleasant.","o":"or תַּעֲנֻג; and (feminine) תַּעֲנֻגָה; from H6026 (עָנַג);","n":5,"w":["delights","delight","delicate","pleasant"]},"H8589":{"l":"תַּעֲנִית","t":"taʻănîyth","p":"tah-an-eeth'","d":"affliction (of self), i.e. fasting","k":"heaviness.","o":"from H6031 (עָנָה);","n":1,"w":["heaviness"]},"H8590":{"l":"תַּעֲנָךְ","t":"Taʻănâk","p":"tah-an-awk'","d":"Taanak or Tanak, a place in Palestine","k":"Taanach, Tanach.","o":"or תַּעְנָךְ; of uncertain derivation;","n":7,"w":["taanach","tanach"]},"H8591":{"l":"תָּעַע","t":"tâʻaʻ","p":"taw-ah'","d":"to cheat; by analogy, to maltreat","k":"deceive, misuse.","o":"a primitive root;","n":2,"w":["deceiver","misused"]},"H8592":{"l":"תַּעֲצֻמָה","t":"taʻătsumâh","p":"tah-ats-oo-maw'","d":"might (plural collective)","k":"power.","o":"from H6105 (עָצַם);","n":1,"w":["power"]},"H8593":{"l":"תַּעַר","t":"taʻar","p":"tah'-ar","d":"a knife or razor (as making bare); also a scabbard (as being bare, i.e. empty)","k":"(pen-) knife, razor, sca