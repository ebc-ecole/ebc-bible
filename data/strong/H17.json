om] strength.","o":"by contraction from H8524 (תָּלַל);","n":5,"w":["heap","strength"]},"H8511":{"l":"תָּלָא","t":"tâlâʼ","p":"taw-law'","d":"to suspend; figuratively (through hesitation) to be uncertain; by implication (of mental dependence) to habituate","k":"be bent, hang (in doubt).","o":"a primitive root;","n":3,"w":["hang","hanged","bent"]},"H8512":{"l":"תֵּל אָבִיב","t":"Têl ʼÂbîyb","p":"tale aw-beeb'","d":"Tel-Abib, a place in Chaldaea","k":"Tel-abib.","o":"from H8510 (תֵּל) and H24 (אָבִיב); mound of green growth;","n":1,"w":["tel-abib"]},"H8513":{"l":"תְּלָאָה","t":"tᵉlâʼâh","p":"tel-aw-aw'","d":"distress","k":"travail, travel, trouble.","o":"from H3811 (לָאָה);","n":4,"w":["travail","trouble"]},"H8514":{"l":"תַּלְאוּבָה","t":"talʼûwbâh","p":"tal-oo-baw'","d":"desiccation","k":"great drought.","o":"from H3851 (לַהַב);","n":1,"w":["drought"]},"H8515":{"l":"תְּלַאשַּׂר","t":"Tᵉlaʼssar","p":"tel-as-sar'","d":"Telassar, a region of Assyria","k":"Telassar.","o":"or תְּלַשַּׂר; of foreign derivation;","n":2,"w":["thelasar","telassar"]},"H8516":{"l":"תַּלְבֹּשֶׁת","t":"talbôsheth","p":"tal-bo'-sheth","d":"a garment","k":"clothing.","o":"from H3847 (לָבַשׁ);","n":1,"w":["clothing"]},"H8517":{"l":"תְּלַג","t":"tᵉlag","p":"tel-ag'","d":"snow","k":"snow.","o":"(Aramaic) corresponding to H7950 (שֶׁלֶג);","n":1,"w":["snow"]},"H8518":{"l":"תָּלָה","t":"tâlâh","p":"taw-law'","d":"to suspend (especially to gibbet)","k":"hang (up).","o":"a primitive root;","n":26,"w":["hanged","hang","up","hanging","hangeth"]},"H8519":{"l":"תְּלוּנָה","t":"tᵉlûwnâh","p":"tel-oo-naw'","d":"a grumbling","k":"murmuring.","o":"or תּלֻנָּה; from H3885 (לוּן) in the sense of obstinacy;","n":7,"w":["murmurings"]},"H8520":{"l":"תֶּלַח","t":"Telach","p":"teh'-lakh","d":"Telach, an Israelite","k":"Telah.","o":"probably from an unused root meaning to dissever; breach;","n":1,"w":["telah"]},"H8521":{"l":"תֵּל חַרְשָׁא","t":"Têl Charshâʼ","p":"tale khar-shaw'","d":"Tel-Charsha, a place in Babylonia","k":"Tel-haresha, Tel-harsa.","o":"from H8510 (תֵּל) and the feminine of H2798 (חֲרָשִׁים); mound of workmanship;","n":2,"w":["tel-harsa","tel-haresha"]},"H8522":{"l":"תְּלִי","t":"tᵉlîy","p":"tel-ee'","d":"a quiver (as slung)","k":"quiver.","o":"probably from H8518 (תָּלָה);","n":1,"w":["quiver"]},"H8523":{"l":"תְּלִיתַי","t":"tᵉlîythay","p":"tel-ee-thah'-ee","d":"third","k":"third.","o":"(Aramaic) or תַּלְתִּי; (Aramaic), ordinal from H8532 (תְּלָת);","n":2,"w":["third"]},"H8524":{"l":"תָּלַל","t":"tâlal","p":"taw-lal'","d":"to pile up, i.e. elevate","k":"eminent. Compare H2048 (הָתַל).","o":"a primitive root;","n":1,"w":["eminent"]},"H8525":{"l":"תֶּלֶם","t":"telem","p":"teh'-lem","d":"a bank or terrace","k":"furrow, ridge.","o":"from an unused root meaning to accumulate;","n":5,"w":["furrows","furrow","ridges"]},"H8526":{"l":"תַּלְמַי","t":"Talmay","p":"tal-mah'-ee","d":"Talmai, the name of a Canaanite and a Syrian","k":"Talmai.","o":"from H8525 (תֶּלֶם); ridged;","n":6,"w":["talmai"]},"H8527":{"l":"תַּלְמִיד","t":"talmîyd","p":"tal-meed'","d":"a pupil","k":"scholar.","o":"from H3925 (לָמַד);","n":1,"w":["scholar"]},"H8528":{"l":"תֵּל מֶלַח","t":"Têl Melach","p":"tale meh'-lakh","d":"Tel-Melach, a place in Babylonia","k":"Tel-melah.","o":"from H8510 (תֵּל) and H4417 (מֶלַח); mound of salt;","n":2,"w":["tel-melah"]},"H8529":{"l":"תָּלַע","t":"tâlaʻ","p":"taw-law'","d":"to crimson, i.e. dye that color","k":"[idiom] scarlet.","o":"a denominative from H8438 (תּוֹלָע);","n":1,"w":["scarlet"]},"H8530":{"l":"תַּלְפִּיָּה","t":"talpîyâh","p":"tal-pee-yaw'","d":"something tall, i.e. (plural collective) slenderness","k":"armoury.","o":"feminine from an unused root meaning to tower;","n":1,"w":["armoury"]},"H8531":{"l":"תְּלַת","t":"tᵉlath","p":"tel-ath'","d":"a tertiary rank","k":"third.","o":"(Aramaic) from H8532 (תְּלָת);","n":2,"w":["third"]},"H8532":{"l":"תְּלָת","t":"tᵉlâth","p":"tel-awth'","d":"three or third","k":"third, three.","o":"(Aramaic) masculine תְּלָתָה; (Ar